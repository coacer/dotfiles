# =============================================================================
# bobthefish Theme Configuration
# =============================================================================

# --------------------------------------------------
# Color Scheme
# --------------------------------------------------

# Set color scheme to Nord
set -g theme_color_scheme nord

# --------------------------------------------------
# Font Settings
# --------------------------------------------------

# Enable Nerd Fonts support for icons (requires Nerd Font installed)
# set -g theme_nerd_fonts yes

# --------------------------------------------------
# Display Options
# --------------------------------------------------

# Git display settings
set -U theme_display_git yes
set -U theme_display_git_dirty no
set -U theme_display_git_untracked no
set -U theme_display_git_stashed no
set -U theme_display_git_ahead_verbose no
set -U theme_display_git_dirty_verbose no

# User and hostname display
# set -g theme_display_user yes
# set -g theme_display_hostname yes

# Show exit status for non-zero codes
# set -g theme_show_exit_status yes

# Display date in right prompt
# set -g theme_display_date yes

# Put cursor on next line
# set -g theme_newline_cursor yes
