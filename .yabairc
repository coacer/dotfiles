#!/usr/bin/env sh

# ============================================================ #
# yabai - macOS用タイリングウィンドウマネージャー
# ============================================================ #
#
# スクリプティング追加機能を使用する場合（高度な機能）:
# sudoをパスワードなしで実行できるように設定する必要があります
# 詳細: https://github.com/koekeishiya/yabai/wiki/Installing-yabai-(latest-release)#configure-scripting-addition
#
# yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
# sudo yabai --load-sa
#

# ============================================================ #
# グローバル設定
# ============================================================ #

# 外部バーの設定 (top:bottom:main)
# sketchybarなど外部ステータスバーを使う場合に設定
# off:40:0 = 上部に40pxのスペースを確保、下部とメインは0px
yabai -m config external_bar off:0:0

# メニューバーの不透明度 (0.0-1.0)
# 1.0 = 完全に不透明、0.0 = 完全に透明
yabai -m config menubar_opacity 1.0

# マウスカーソルがフォーカスに追従するか
# off = フォーカス変更時にマウスカーソルは移動しない
# on  = フォーカスされたウィンドウにマウスカーソルが自動移動
yabai -m config mouse_follows_focus on

# フォーカスがマウスカーソルに追従するか
# off       = マウスを移動してもフォーカスは変わらない
# autoraise = マウス下のウィンドウが自動的にフォーカスされ前面に
# autofocus = マウス下のウィンドウが自動的にフォーカスされる（前面には来ない）
yabai -m config focus_follows_mouse off

# 複数ディスプレイの配置順序
# default    = macOSの設定に従う
# horizontal = 水平方向に並べる
# vertical   = 垂直方向に並べる
yabai -m config display_arrangement_order default

# 新しいウィンドウをどのディスプレイに表示するか
# default = アプリケーションの設定に従う
# focused = フォーカス中のディスプレイに表示
# cursor  = マウスカーソルがあるディスプレイに表示
yabai -m config window_origin_display default

# 新しいウィンドウの配置場所
# first_child  = 現在のウィンドウの最初の子として配置
# second_child = 現在のウィンドウの2番目の子として配置
yabai -m config window_placement second_child

# ウィンドウの挿入ポイント
# focused = フォーカス中のウィンドウの位置に挿入
yabai -m config window_insertion_point focused

# ウィンドウのズーム状態を永続化するか
# on  = ズーム状態を記憶する
# off = ズーム状態をリセット
yabai -m config window_zoom_persist on

# ウィンドウに影を表示するか
# on    = 影を表示（macOSデフォルト）
# off   = 影を非表示
# float = フローティングウィンドウのみ影を表示
yabai -m config window_shadow on

# ウィンドウアニメーションの継続時間（秒）
# 0.0 = アニメーションなし（即座に移動）
yabai -m config window_animation_duration 0.0

# ウィンドウアニメーションのイージング関数
# ease_in_sine, ease_out_sine, ease_in_out_sine
# ease_in_quad, ease_out_quad, ease_in_out_quad
# ease_in_cubic, ease_out_cubic, ease_in_out_cubic
# ease_in_quart, ease_out_quart, ease_in_out_quart
# ease_in_quint, ease_out_quint, ease_in_out_quint
# ease_in_expo, ease_out_expo, ease_in_out_expo
# ease_in_circ, ease_out_circ, ease_in_out_circ
yabai -m config window_animation_easing ease_out_circ

# ウィンドウの不透明度変更アニメーションの継続時間（秒）
# 0.0 = アニメーションなし
yabai -m config window_opacity_duration 0.0

# アクティブウィンドウの不透明度 (0.0-1.0)
# 1.0 = 完全に不透明
yabai -m config active_window_opacity 1.0

# 非アクティブウィンドウの不透明度 (0.0-1.0)
# 0.90 = 少し透明
yabai -m config normal_window_opacity 0.90

# ウィンドウの不透明度変更を有効にするか
# on  = アクティブ/非アクティブで不透明度が変わる
# off = 全ウィンドウが完全に不透明
yabai -m config window_opacity off

# ウィンドウ挿入位置のフィードバック色（16進数カラーコード）
# 0xAARRGGBB形式（AA=アルファ値、RR=赤、GG=緑、BB=青）
yabai -m config insert_feedback_color 0xffd75f5f

# ウィンドウ分割時の比率 (0.0-1.0)
# 0.50 = 50:50で分割
yabai -m config split_ratio 0.50

# ウィンドウ分割の方向
# auto       = 自動（長い辺を分割）
# vertical   = 常に垂直分割
# horizontal = 常に水平分割
yabai -m config split_type auto

# ウィンドウサイズの自動バランス調整
# on  = ウィンドウ追加/削除時に自動的に全ウィンドウのサイズを均等化
# off = 手動でバランス調整が必要
yabai -m config auto_balance off

# ウィンドウ周りのパディング（ピクセル）
yabai -m config top_padding    0
yabai -m config bottom_padding 0
yabai -m config left_padding   0
yabai -m config right_padding  0

# ウィンドウ間のギャップ（ピクセル）
yabai -m config window_gap 06

# レイアウトモード
# bsp   = バイナリスペースパーティション（タイリング）
# stack = スタックレイアウト（全ウィンドウを重ねる）
# float = フローティング（ウィンドウを自由配置）
yabai -m config layout bsp

# マウス操作時の修飾キー
# fn, shift, cmd, alt, ctrl
yabai -m config mouse_modifier alt

# 修飾キー + 左クリックの動作
# move   = ウィンドウを移動
# resize = ウィンドウをリサイズ
yabai -m config mouse_action1 move

# 修飾キー + 右クリックの動作
# move   = ウィンドウを移動
# resize = ウィンドウをリサイズ
yabai -m config mouse_action2 resize

# マウスでドラッグ&ドロップした時の動作
# swap  = ウィンドウを入れ替え
# stack = ウィンドウをスタック
yabai -m config mouse_drop_action swap

yabai -m rule --add app="^zoom.us$"          manage=off
yabai -m rule --add app="^システム設定$" manage=off
yabai -m rule --add app="^Finder$"             manage=off

echo "yabai configuration loaded.."

borders active_color=0xff7cfff5 inactive_color=0xff494d64 width=8.0 &
